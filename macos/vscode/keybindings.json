// Place your key bindings in this file to override the defaults
[
  {
    "key": "shift+cmd+;",
    "command": "editor.action.insertSnippet",
    "args": {
      "snippet": "console.debug(${TM_SELECTED_TEXT}$0);"
    },
    "when": "editorTextFocus"
  },
  {
    "key": "cmd+ctrl+up",
    "command": "moveActiveEditor",
    "args": {
      "to": "left",
      "by": "tab",
    }
  },
  {
    "key": "cmd+ctrl+down",
    "command": "moveActiveEditor",
    "when": "!terminalFocus",
    "args": {
      "to": "right",
      "by": "tab"
    }
  },
  {
    "key": "ctrl+c",
    "command": "cursorMove",
    "args": {
      "to": "viewPortCenter"
    }
  },
  {
    "key": "ctrl+up",
    "command": "cursorMove",
    "args": {
      "to": "up",
      "by": "line",
      "value": 10
    }
  },
  {
    "key": "ctrl+down",
    "command": "cursorMove",
    "args": {
      "to": "down",
      "by": "line",
      "value": 10
    }
  },
  {
    "key": "cmd+shift+c",
},
{
    "key": "shift+enter",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
        "text": "\\\r\n"
    },
    "when": "terminalFocus"
}
]